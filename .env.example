# AI_API_KEY: the API key of whichever AI service describes the screenshots.
# The service is recognised from the key itself: Anthropic (sk-ant-...), OpenAI
# (sk-...), Google Gemini (AIza...), OpenRouter (sk-or-...), xAI (xai-...),
# Groq (gsk_...). Leave it empty to skip the AI step.
AI_API_KEY=

# Optional. AI_MODEL picks a model of that service (default: its recommended
# vision model; OpenRouter, xAI, Groq and Mistral have no default and need one).
# AI_PROVIDER names the service when the key doesn't reveal it (e.g. mistral).
# AI_BASE_URL points at any other OpenAI-compatible endpoint, e.g. a local
# Ollama at http://localhost:11434/v1 (then AI_MODEL is required too).
AI_MODEL=
AI_PROVIDER=
AI_BASE_URL=

# DNS_RESOLVERS lists the DNS servers every lookup goes to, comma-separated and
# tried in order. Fixed public resolvers keep results the same on any machine
# (no VPN or corporate filtering). --resolvers on the command line overrides it.
DNS_RESOLVERS=1.1.1.1,8.8.8.8

# Optional results database. Results always go to run folders under runs/; set
# RESULTS_DB to a file name (e.g. results.sqlite - relative to this folder) to
# also append every check to that SQLite file: each domain's history over time,
# screenshots and page files included. Nothing to install. Inspect it with: ./recon db domains
# RESULTS_CACHE_HOURS > 0 reuses a domain's stored check when it is newer than
# that, instead of visiting the site again (0 = always check again).
# --db and --cache-hours on the command line override both.
RESULTS_DB=
RESULTS_CACHE_HOURS=0

# Takedown reports (./recon takedown): who signs the drafts, and an optional file -
# e.g. a trademark registration or an authorisation letter - attached to every
# draft email. Left empty, drafts carry [your name]-style placeholders.
REPORTER_NAME=
REPORTER_ORG=
REPORTER_EMAIL=
TAKEDOWN_ATTACHMENT=
